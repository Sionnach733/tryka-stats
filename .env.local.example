# Path to the tryka-scraper SQLite database.
# If unset, the app falls back to ../tryka-scraper/tryka.db
TRYKA_DB_PATH=../tryka-scraper/tryka.db

# Writable app database for logins and claims (created on first use).
# If unset, the app uses ./data/app.db. In production keep it outside the repo
# and back it up — it's the only data that can't be regenerated.
APP_DB_PATH=./data/app.db

# Public base URL used in emailed sign-in links.
APP_URL=http://localhost:3000

# Resend API key (contact form + sign-in emails). If unset, sign-in links are
# logged to the server console instead of emailed.
RESEND_API_KEY=
